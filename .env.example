# Which LLM provider to use: "anthropic" or "openai"
LLM_PROVIDER=anthropic

# Provider API keys (only the one matching LLM_PROVIDER is required)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Model names
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_MODEL=gpt-4o-mini

# Qdrant vector store
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=codebase_chat_tool

# Local embedding model (sentence-transformers)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# Retrieval tuning
RETRIEVAL_TOP_K=8
RETRIEVAL_CANDIDATE_K=30

# Index storage location (relative to indexed repo, or absolute)
INDEX_DIR=.codebase_chat_tool
